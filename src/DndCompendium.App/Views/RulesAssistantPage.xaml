<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DndCompendium.App.Views.RulesAssistantPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,32" Spacing="16">
            <Border Padding="20" Style="{StaticResource HeroCardStyle}">
                <VerticalStackLayout Spacing="7">
                    <Label Style="{StaticResource EyebrowLabelStyle}" Text="CONSULTAS DE D&amp;D" />
                    <Label Style="{StaticResource DisplayLabelStyle}" Text="Asistente de Reglas" />
                    <Label
                        Margin="0,4,0,0"
                        Style="{StaticResource MutedLabelStyle}"
                        Text="Consultá el Notebook de reglas compartido y recibí respuestas basadas en sus fuentes." />
                </VerticalStackLayout>
            </Border>

            <Border Padding="18" Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource TitleLabelStyle}" Text="Abrir Gemini Notebook" />
                    <Label
                        Style="{StaticResource MutedLabelStyle}"
                        Text="Se abrirá en Google para que puedas iniciar sesión y hacer preguntas. La biblioteca, los personajes y los recursos siguen funcionando offline." />
                    <Button
                        Clicked="OnOpenAssistantClicked"
                        SemanticProperties.Description="Abrir Asistente de Reglas en Google"
                        Style="{StaticResource AccentButtonStyle}"
                        Text="Abrir Asistente de Reglas" />
                    <Button
                        Clicked="OnCopyLinkClicked"
                        SemanticProperties.Description="Copiar enlace del Asistente de Reglas"
                        Style="{StaticResource SmallSecondaryButtonStyle}"
                        Text="Copiar enlace" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionLabelStyle}" Text="IMPORTANTE" />
                    <Label Style="{StaticResource MutedLabelStyle}" Text="• El asistente requiere Internet y una cuenta de Google." />
                    <Label Style="{StaticResource MutedLabelStyle}" Text="• Las respuestas dependen de las fuentes configuradas en el Notebook." />
                    <Label Style="{StaticResource MutedLabelStyle}" Text="• Verificá con tu DM cualquier interpretación dudosa de una regla." />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
