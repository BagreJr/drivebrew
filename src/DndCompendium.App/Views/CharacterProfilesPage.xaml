<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DndCompendium.App.Views.CharacterProfilesPage"
    x:Name="CharactersRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:DndCompendium.App.ViewModels"
    x:DataType="viewModels:CharacterProfilesViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Border Grid.Row="0" Margin="12,6,12,4" Padding="12,8" Style="{StaticResource HeroCardStyle}">
            <VerticalStackLayout Spacing="3">
                <Label FontAttributes="Bold" FontSize="18" Text="Personajes" TextColor="{StaticResource PaperLight}" />
                <Label FontSize="11" Text="{Binding ActiveSummary}" TextColor="{StaticResource Gold}" />
                <Label FontSize="11" Text="Cada perfil guarda sus propios Spells y Exploits favoritos y preparados." TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="1" Margin="12,4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry MaxLength="60" Placeholder="Nombre del nuevo personaje" Text="{Binding NewCharacterName}" />
            <Button Grid.Column="1" Command="{Binding CreateCommand}" Style="{StaticResource SmallAccentButtonStyle}" Text="Crear" />
        </Grid>

        <Grid Grid.Row="2" Margin="16,2,16,6" RowDefinitions="Auto,Auto">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Grid.Row="1" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabelStyle}" Text="{Binding ErrorMessage}" />
        </Grid>

        <CollectionView Grid.Row="3" Margin="10,0" ItemsSource="{Binding Characters}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:CharacterProfileItemViewModel">
                    <Border Margin="2,0,2,9" Padding="13" Style="{StaticResource CardStyle}">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">
                            <Label FontAttributes="Bold" FontSize="16" Text="{Binding Name}" TextColor="{StaticResource TextPrimary}" />
                            <Label Grid.Column="1" FontAttributes="Bold" FontSize="10" Text="{Binding StatusText}" TextColor="{StaticResource Gold}" />
                            <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" HorizontalOptions="End" Spacing="6">
                                <Button Command="{Binding BindingContext.SelectCommand, Source={x:Reference CharactersRoot}}" CommandParameter="{Binding .}" IsEnabled="{Binding IsNotActive}" Style="{StaticResource SmallAccentButtonStyle}" Text="Usar" />
                                <Button Clicked="OnRenameClicked" CommandParameter="{Binding .}" Style="{StaticResource SmallSecondaryButtonStyle}" Text="Renombrar" />
                                <Button Clicked="OnDeleteClicked" CommandParameter="{Binding .}" IsEnabled="{Binding CanDelete}" Style="{StaticResource SmallSecondaryButtonStyle}" Text="Eliminar" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>
