<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DndCompendium.App.Views.SpellDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:DndCompendium.App.ViewModels"
    x:DataType="viewModels:SpellDetailViewModel"
    Title="Detalle del spell">

    <Grid>
        <ActivityIndicator
            HeightRequest="34"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center"
            WidthRequest="34" />
        <ScrollView IsVisible="{Binding HasSpell}">
            <VerticalStackLayout Padding="14,10,14,32" Spacing="10">
                <Border Padding="16" Style="{StaticResource HeroCardStyle}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                        <Label FontAttributes="Bold" FontSize="24" Text="{Binding Spell.Name}" TextColor="{StaticResource PaperLight}" />
                        <Label Grid.Row="1" FontSize="13" TextColor="{StaticResource Gold}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Spell.LevelText}" />
                                    <Span Text=" · " />
                                    <Span Text="{Binding Spell.SchoolText}" />
                                    <Span Text=" · " />
                                    <Span Text="{Binding Spell.OriginsText}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Grid.Row="2" FontSize="12" Text="{Binding Spell.ClassesText}" TextColor="{StaticResource TextMuted}" />
                        <VerticalStackLayout Grid.RowSpan="3" Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Button
                                Command="{Binding ToggleFavoriteCommand}"
                                Style="{StaticResource SmallSecondaryButtonStyle}"
                                Text="{Binding Spell.FavoriteActionText}" />
                            <Button
                                Command="{Binding TogglePreparedCommand}"
                                Style="{StaticResource SmallAccentButtonStyle}"
                                Text="{Binding Spell.PreparedActionText}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Padding="14" Style="{StaticResource CardStyle}">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                        <VerticalStackLayout><Label Style="{StaticResource EyebrowLabelStyle}" Text="TIEMPO DE CASTEO" /><Label Style="{StaticResource BodyLabelStyle}" Text="{Binding Spell.CastingTime}" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1"><Label Style="{StaticResource EyebrowLabelStyle}" Text="RANGO" /><Label Style="{StaticResource BodyLabelStyle}" Text="{Binding Spell.Range}" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1"><Label Style="{StaticResource EyebrowLabelStyle}" Text="DURACIÓN" /><Label Style="{StaticResource BodyLabelStyle}" Text="{Binding Spell.Duration}" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1"><Label Style="{StaticResource EyebrowLabelStyle}" Text="CONCENTRACIÓN" /><Label Style="{StaticResource BodyLabelStyle}" Text="{Binding Spell.ConcentrationText}" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="2"><Label Style="{StaticResource EyebrowLabelStyle}" Text="RITUAL" /><Label Style="{StaticResource BodyLabelStyle}" Text="{Binding Spell.RitualText}" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="2" Grid.Column="1"><Label Style="{StaticResource EyebrowLabelStyle}" Text="COMPONENTES" /><Label Style="{StaticResource BodyLabelStyle}" Text="{Binding Spell.ComponentsText}" /></VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Padding="14" IsVisible="{Binding Spell.HasMaterialDescription}" Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="5"><Label Style="{StaticResource SectionLabelStyle}" Text="Materiales" /><Label Style="{StaticResource BodyLabelStyle}" Text="{Binding Spell.MaterialDescription}" /></VerticalStackLayout>
                </Border>
                <Border Padding="14" Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="5"><Label Style="{StaticResource SectionLabelStyle}" Text="Qué hace" /><Label Style="{StaticResource BodyLabelStyle}" Text="{Binding Spell.Effect}" /></VerticalStackLayout>
                </Border>
                <Border Padding="14" IsVisible="{Binding Spell.HasHigherLevels}" Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="5"><Label Style="{StaticResource SectionLabelStyle}" Text="Al lanzarlo con un slot superior" /><Label Style="{StaticResource BodyLabelStyle}" Text="{Binding Spell.HigherLevels}" /></VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <Border Margin="18" Padding="14" BackgroundColor="{StaticResource ErrorSurface}" IsVisible="{Binding HasError}" Stroke="{StaticResource Error}" VerticalOptions="Start">
            <Label Style="{StaticResource ErrorLabelStyle}" Text="{Binding ErrorMessage}" />
        </Border>
    </Grid>
</ContentPage>
