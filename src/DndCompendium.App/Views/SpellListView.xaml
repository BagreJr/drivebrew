<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DndCompendium.App.Views.SpellListView"
    x:Name="SpellListRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:DndCompendium.App.ViewModels"
    x:DataType="viewModels:SpellListViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <Border
            Grid.Row="0"
            Margin="12,6,12,4"
            Padding="12,7"
            Style="{StaticResource HeroCardStyle}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="{Binding PageTitle}"
                    TextColor="{StaticResource PaperLight}" />
                <Label
                    Grid.Row="1"
                    Margin="0,2,8,0"
                    FontSize="11"
                    Text="{Binding PageSubtitle}"
                    TextColor="{StaticResource TextMuted}" />
                <Label
                    Grid.Row="2"
                    Margin="0,4,8,0"
                    FontAttributes="Bold"
                    FontSize="10"
                    Text="{Binding ActiveCharacterText}"
                    TextColor="{StaticResource Gold}" />
                <ActivityIndicator
                    Grid.RowSpan="3"
                    Grid.Column="1"
                    HeightRequest="24"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    VerticalOptions="Center"
                    WidthRequest="24" />
            </Grid>
        </Border>

        <SearchBar
            Grid.Row="1"
            Margin="12,2"
            Placeholder="Buscar por nombre o efecto"
            Style="{StaticResource CompendiumSearchBarStyle}"
            Text="{Binding SearchQuery}" />

        <ScrollView
            Grid.Row="2"
            Margin="12,2,12,4"
            HorizontalScrollBarVisibility="Never"
            Orientation="Horizontal">
            <HorizontalStackLayout Spacing="8">
                <VerticalStackLayout WidthRequest="116" Spacing="2">
                    <Label Style="{StaticResource EyebrowLabelStyle}" Text="NIVEL" />
                    <Picker
                        ItemsSource="{Binding LevelOptions}"
                        SelectedItem="{Binding SelectedLevel}"
                        Style="{StaticResource CompactPickerStyle}" />
                </VerticalStackLayout>
                <VerticalStackLayout WidthRequest="138" Spacing="2">
                    <Label Style="{StaticResource EyebrowLabelStyle}" Text="CLASE" />
                    <Picker
                        ItemsSource="{Binding ClassOptions}"
                        SelectedItem="{Binding SelectedClass}"
                        Style="{StaticResource CompactPickerStyle}" />
                </VerticalStackLayout>
                <VerticalStackLayout WidthRequest="116" Spacing="2">
                    <Label Style="{StaticResource EyebrowLabelStyle}" Text="ORIGEN" />
                    <Picker
                        ItemsSource="{Binding OriginOptions}"
                        SelectedItem="{Binding SelectedOrigin}"
                        Style="{StaticResource CompactPickerStyle}" />
                </VerticalStackLayout>
                <VerticalStackLayout WidthRequest="138" Spacing="2">
                    <Label Style="{StaticResource EyebrowLabelStyle}" Text="ESCUELA" />
                    <Picker
                        ItemsSource="{Binding SchoolOptions}"
                        SelectedItem="{Binding SelectedSchool}"
                        Style="{StaticResource CompactPickerStyle}" />
                </VerticalStackLayout>
                <VerticalStackLayout WidthRequest="130" Spacing="2">
                    <Label Style="{StaticResource EyebrowLabelStyle}" Text="CONCENTRACIÓN" />
                    <Picker
                        ItemsSource="{Binding BooleanOptions}"
                        SelectedItem="{Binding SelectedConcentration}"
                        Style="{StaticResource CompactPickerStyle}" />
                </VerticalStackLayout>
                <VerticalStackLayout WidthRequest="110" Spacing="2">
                    <Label Style="{StaticResource EyebrowLabelStyle}" Text="RITUAL" />
                    <Picker
                        ItemsSource="{Binding BooleanOptions}"
                        SelectedItem="{Binding SelectedRitual}"
                        Style="{StaticResource CompactPickerStyle}" />
                </VerticalStackLayout>
                <VerticalStackLayout WidthRequest="180" Spacing="2">
                    <Label Style="{StaticResource EyebrowLabelStyle}" Text="ORDEN" />
                    <Picker
                        ItemsSource="{Binding SortOptions}"
                        SelectedItem="{Binding SelectedSort}"
                        Style="{StaticResource CompactPickerStyle}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="3" Margin="16,2,16,6" RowDefinitions="Auto,Auto">
            <Label Style="{StaticResource SectionLabelStyle}" Text="{Binding ResultSummary}" />
            <Border
                Grid.Row="1"
                Margin="0,4,0,0"
                Padding="10,7"
                BackgroundColor="{StaticResource ErrorSurface}"
                IsVisible="{Binding HasError}"
                Stroke="{StaticResource Error}">
                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                <Label Style="{StaticResource ErrorLabelStyle}" Text="{Binding ErrorMessage}" />
            </Border>
        </Grid>

        <RefreshView
            Grid.Row="4"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsRefreshing}">
            <CollectionView
                Margin="10,0"
                ItemsSource="{Binding Spells}"
                SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="28" Spacing="8">
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource TitleLabelStyle}"
                            Text="No hay spells para mostrar" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource MutedLabelStyle}"
                            Text="Cambiá los filtros o marcá spells como preparados." />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:SpellItemViewModel">
                        <Border Margin="2,0,2,9" Padding="13" Style="{StaticResource CardStyle}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    CommandParameter="{Binding .}"
                                    NumberOfTapsRequired="1"
                                    Tapped="OnSpellCardTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="5">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding Name}"
                                    TextColor="{StaticResource TextPrimary}" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="10"
                                    Text="{Binding PreparedStatusText}"
                                    TextColor="{StaticResource Gold}" />
                                <Label
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    FontSize="12">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding LevelText}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding SchoolText}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding OriginsText}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    FontSize="11"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Text="{Binding Effect}"
                                    TextColor="{StaticResource TextMuted}" />
                                <Label
                                    Grid.Row="3"
                                    Grid.ColumnSpan="2"
                                    FontSize="11"
                                    TextColor="{StaticResource TextMuted}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Casteo: " />
                                            <Span Text="{Binding CastingTime}" />
                                            <Span Text="  ·  Rango: " />
                                            <Span Text="{Binding Range}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <HorizontalStackLayout Grid.Row="4" Grid.ColumnSpan="2" HorizontalOptions="End" Spacing="8">
                                    <Button
                                        Command="{Binding BindingContext.OpenDetailCommand, Source={x:Reference SpellListRoot}}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource SmallSecondaryButtonStyle}"
                                        Text="Ver todo" />
                                    <Button
                                        Command="{Binding BindingContext.ToggleFavoriteCommand, Source={x:Reference SpellListRoot}}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource SmallSecondaryButtonStyle}"
                                        Text="{Binding FavoriteActionText}" />
                                    <Button
                                        Command="{Binding BindingContext.TogglePreparedCommand, Source={x:Reference SpellListRoot}}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource SmallAccentButtonStyle}"
                                        Text="{Binding PreparedActionText}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentView>
