<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DndCompendium.App.Views.CharacterSheetPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:DndCompendium.App.ViewModels"
    x:DataType="viewModels:CharacterSheetViewModel"
    Title="Character Sheet">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Margin="10,6,10,4" Padding="12,7" Style="{StaticResource HeroCardStyle}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                <Label FontAttributes="Bold" FontSize="18" Text="{Binding CharacterName}" TextColor="{StaticResource PaperLight}" />
                <Label Grid.Row="1" FontSize="10" Text="{Binding StatusText}" TextColor="{StaticResource Gold}" />
                <ActivityIndicator Grid.RowSpan="2" Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <HybridWebView
                x:Name="SheetWebView"
                DefaultFile="character-sheet.html"
                HybridRoot="wwwroot"
                IsVisible="{Binding HasCharacter}"
                RawMessageReceived="OnRawMessageReceived"
                WebResourceRequested="OnWebResourceRequested" />

            <VerticalStackLayout HorizontalOptions="Center" IsVisible="{Binding IsBusy}" Spacing="10" VerticalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsBusy}" />
                <Label Style="{StaticResource MutedLabelStyle}" Text="Abriendo la hoja…" />
            </VerticalStackLayout>

            <Border Margin="20" Padding="18" IsVisible="{Binding HasError}" Style="{StaticResource CardStyle}" VerticalOptions="Center">
                <Label Style="{StaticResource ErrorLabelStyle}" Text="{Binding ErrorMessage}" />
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="10,4,10,8" Padding="6" Style="{StaticResource CardStyle}">
            <FlexLayout AlignItems="Center" Direction="Row" JustifyContent="Center" Wrap="Wrap">
                <Button Margin="3" Command="{Binding SaveCommand}" Style="{StaticResource SmallAccentButtonStyle}" Text="Guardar" />
                <Button Margin="3" Command="{Binding OpenPdfCommand}" Style="{StaticResource SmallSecondaryButtonStyle}" Text="Ver PDF" />
                <Button Margin="3" Command="{Binding ShareCommand}" Style="{StaticResource SmallSecondaryButtonStyle}" Text="Guardar copia" />
            </FlexLayout>
        </Border>
    </Grid>
</ContentPage>
