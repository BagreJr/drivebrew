<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DndCompendium.App.Views.CharacterSheetPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:DndCompendium.App.ViewModels"
    x:DataType="viewModels:CharacterSheetViewModel"
    Shell.NavBarIsVisible="False"
    Title="Character Sheet">

    <Grid>
        <HybridWebView
            x:Name="SheetWebView"
            DefaultFile="character-sheet.html"
            HybridRoot="wwwroot"
            IsVisible="{Binding HasCharacter}"
            RawMessageReceived="OnRawMessageReceived"
            WebResourceRequested="OnWebResourceRequested" />

        <VerticalStackLayout HorizontalOptions="Center" IsVisible="{Binding IsBusy}" Spacing="10" VerticalOptions="Center">
            <ActivityIndicator IsRunning="{Binding IsBusy}" />
            <Label Style="{StaticResource MutedLabelStyle}" Text="Abriendo personaje…" />
        </VerticalStackLayout>

        <Border Margin="20" Padding="18" IsVisible="{Binding HasError}" Style="{StaticResource CardStyle}" VerticalOptions="Center">
            <VerticalStackLayout Spacing="10">
                <Label Style="{StaticResource ErrorLabelStyle}" Text="{Binding ErrorMessage}" />
                <Button Clicked="OnCloseErrorClicked" Style="{StaticResource SmallSecondaryButtonStyle}" Text="Volver" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
