<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DndCompendium.App.Views.CharacterSheetPage"
    x:Name="SheetRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:DndCompendium.App.ViewModels"
    x:DataType="viewModels:CharacterSheetViewModel"
    Title="Character Sheet">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Row="0" Margin="12,8,12,4" Padding="14,10" Style="{StaticResource HeroCardStyle}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                <Label FontAttributes="Bold" FontSize="21" Text="{Binding CharacterName}" TextColor="{StaticResource PaperLight}" />
                <Label Grid.Row="1" FontSize="11" Text="{Binding StatusText}" TextColor="{StaticResource Gold}" />
                <ActivityIndicator Grid.RowSpan="2" Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="12,4" Padding="12,8" Style="{StaticResource CardStyle}">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                <Button Command="{Binding PreviousSectionCommand}" IsEnabled="{Binding CanGoPrevious}" Style="{StaticResource SmallSecondaryButtonStyle}" Text="‹" />
                <Picker Grid.Column="1" ItemDisplayBinding="{Binding Name}" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Title="Sección" />
                <Button Grid.Column="2" Command="{Binding NextSectionCommand}" IsEnabled="{Binding CanGoNext}" Style="{StaticResource SmallSecondaryButtonStyle}" Text="›" />
                <Label Grid.Row="1" Grid.ColumnSpan="2" FontSize="11" Text="{Binding SectionHelp}" TextColor="{StaticResource TextMuted}" />
                <Label Grid.Row="1" Grid.Column="2" FontAttributes="Bold" FontSize="11" HorizontalTextAlignment="End" Text="{Binding SectionPosition}" TextColor="{StaticResource Gold}" />
            </Grid>
        </Border>

        <CollectionView
            Grid.Row="2"
            Margin="10,4"
            ItemsSource="{Binding VisibleFields}"
            SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Margin="16" HorizontalTextAlignment="Center" Text="Elegí una sección para completar la hoja." TextColor="{StaticResource TextMuted}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:CharacterSheetFieldViewModel">
                    <Border Margin="2,0,2,8" Padding="12,9" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="6">
                            <Label FontAttributes="Bold" FontSize="13" Text="{Binding Label}" TextColor="{StaticResource TextPrimary}" />
                            <Entry
                                IsVisible="{Binding IsSingleLine}"
                                Keyboard="{Binding InputKeyboard}"
                                Placeholder="Escribir…"
                                Text="{Binding Value, Mode=TwoWay}" />
                            <Editor
                                AutoSize="TextChanges"
                                HeightRequest="110"
                                IsVisible="{Binding IsMultiline}"
                                Placeholder="Escribir…"
                                Text="{Binding Value, Mode=TwoWay}" />
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasToggle}">
                                <Label FontSize="12" Text="{Binding ToggleLabel}" TextColor="{StaticResource TextMuted}" VerticalTextAlignment="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding IsChecked, Mode=TwoWay}" OnColor="{StaticResource Gold}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="3" Margin="10,4,10,8" Padding="8" Style="{StaticResource CardStyle}">
            <FlexLayout AlignItems="Center" Direction="Row" JustifyContent="Center" Wrap="Wrap">
                <Button Margin="3" Command="{Binding SaveCommand}" Style="{StaticResource SmallAccentButtonStyle}" Text="Guardar" />
                <Button Margin="3" Command="{Binding OpenPdfCommand}" Style="{StaticResource SmallSecondaryButtonStyle}" Text="Ver PDF" />
                <Button Margin="3" Command="{Binding ShareCommand}" Style="{StaticResource SmallSecondaryButtonStyle}" Text="Guardar copia" />
            </FlexLayout>
        </Border>

        <Border Grid.RowSpan="4" Margin="18" Padding="14" BackgroundColor="{StaticResource ErrorSurface}" IsVisible="{Binding HasError}" Stroke="{StaticResource Error}" VerticalOptions="Start">
            <Label Style="{StaticResource ErrorLabelStyle}" Text="{Binding ErrorMessage}" />
        </Border>
    </Grid>
</ContentPage>
