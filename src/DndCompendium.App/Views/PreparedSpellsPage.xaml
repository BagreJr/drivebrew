<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DndCompendium.App.Views.PreparedSpellsPage"
    x:Name="PreparedRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:DndCompendium.App.ViewModels"
    x:DataType="viewModels:PreparedSpellsViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Margin="12,6,12,4" Padding="12,8" Style="{StaticResource HeroCardStyle}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <Label FontAttributes="Bold" FontSize="18" Text="{Binding PageTitle}" TextColor="{StaticResource PaperLight}" />
                <Label Grid.Row="1" Margin="0,2,8,0" FontSize="11" Text="{Binding PageSubtitle}" TextColor="{StaticResource TextMuted}" />
                <ActivityIndicator Grid.RowSpan="2" Grid.Column="1" HeightRequest="24" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" WidthRequest="24" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="16,4,16,6" RowDefinitions="Auto,Auto">
            <Label Style="{StaticResource SectionLabelStyle}" Text="{Binding ResultSummary}" />
            <Label Grid.Row="1" Margin="0,5,0,0" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabelStyle}" Text="{Binding ErrorMessage}" />
        </Grid>
        <RefreshView Grid.Row="2" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView Margin="10,0" ItemsSource="{Binding Items}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="28" Spacing="8">
                        <Label HorizontalTextAlignment="Center" Style="{StaticResource TitleLabelStyle}" Text="Todavía no hay preparados" />
                        <Label HorizontalTextAlignment="Center" Style="{StaticResource MutedLabelStyle}" Text="{Binding EmptyText}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:SavedItemViewModel">
                        <Border Margin="2,0,2,9" Padding="13" Style="{StaticResource CardStyle}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <Label FontAttributes="Bold" FontSize="16" Text="{Binding Name}" TextColor="{StaticResource TextPrimary}" />
                                <Label Grid.Column="1" FontAttributes="Bold" FontSize="10" Text="{Binding Kind}" TextColor="{StaticResource Gold}" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2" FontSize="12" Text="{Binding LevelText}" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Margin="80,0,0,0" FontSize="12" Text="{Binding DetailText}" TextColor="{StaticResource TextMuted}" />
                                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" HorizontalOptions="End" Spacing="6">
                                    <Button Command="{Binding BindingContext.RemoveCommand, Source={x:Reference PreparedRoot}}" CommandParameter="{Binding .}" Style="{StaticResource SmallSecondaryButtonStyle}" Text="Quitar" />
                                    <Button Command="{Binding BindingContext.OpenDetailCommand, Source={x:Reference PreparedRoot}}" CommandParameter="{Binding .}" Style="{StaticResource SmallAccentButtonStyle}" Text="Ver todo" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentView>
