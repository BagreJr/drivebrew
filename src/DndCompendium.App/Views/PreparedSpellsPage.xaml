<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DndCompendium.App.Views.PreparedSpellsPage"
    x:Name="PreparedRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:DndCompendium.App.ViewModels"
    x:DataType="viewModels:PreparedSpellsViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Border Grid.Row="0" Margin="12,6,12,4" Padding="12,8" Style="{StaticResource HeroCardStyle}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <Label FontAttributes="Bold" FontSize="18" Text="{Binding PageTitle}" TextColor="{StaticResource PaperLight}" />
                <Label Grid.Row="1" Margin="0,2,8,0" FontSize="11" Text="{Binding PageSubtitle}" TextColor="{StaticResource TextMuted}" />
                <ActivityIndicator Grid.RowSpan="2" Grid.Column="1" HeightRequest="24" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" WidthRequest="24" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto">
            <SearchBar
                Margin="12,2"
                Placeholder="Buscar en preparados"
                Style="{StaticResource CompendiumSearchBarStyle}"
                Text="{Binding SearchQuery}" />
            <ScrollView
                Grid.Row="1"
                Margin="12,2,12,4"
                HorizontalScrollBarVisibility="Never"
                Orientation="Horizontal">
                <HorizontalStackLayout Spacing="8">
                    <VerticalStackLayout WidthRequest="120" Spacing="2">
                        <Label Style="{StaticResource EyebrowLabelStyle}" Text="CONTENIDO" />
                        <Picker ItemsSource="{Binding ContentOptions}" SelectedItem="{Binding SelectedContent}" Style="{StaticResource CompactPickerStyle}" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout IsVisible="{Binding ShowSpellFilters}" Spacing="8">
                        <VerticalStackLayout WidthRequest="116" Spacing="2">
                            <Label Style="{StaticResource EyebrowLabelStyle}" Text="NIVEL" />
                            <Picker ItemsSource="{Binding SpellLevelOptions}" SelectedItem="{Binding SelectedSpellLevel}" Style="{StaticResource CompactPickerStyle}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout WidthRequest="138" Spacing="2">
                            <Label Style="{StaticResource EyebrowLabelStyle}" Text="CLASE" />
                            <Picker ItemsSource="{Binding SpellClassOptions}" SelectedItem="{Binding SelectedSpellClass}" Style="{StaticResource CompactPickerStyle}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout WidthRequest="116" Spacing="2">
                            <Label Style="{StaticResource EyebrowLabelStyle}" Text="ORIGEN" />
                            <Picker ItemsSource="{Binding OriginOptions}" SelectedItem="{Binding SelectedOrigin}" Style="{StaticResource CompactPickerStyle}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout WidthRequest="138" Spacing="2">
                            <Label Style="{StaticResource EyebrowLabelStyle}" Text="ESCUELA" />
                            <Picker ItemsSource="{Binding SchoolOptions}" SelectedItem="{Binding SelectedSchool}" Style="{StaticResource CompactPickerStyle}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout WidthRequest="130" Spacing="2">
                            <Label Style="{StaticResource EyebrowLabelStyle}" Text="CONCENTRACIÓN" />
                            <Picker ItemsSource="{Binding BooleanOptions}" SelectedItem="{Binding SelectedConcentration}" Style="{StaticResource CompactPickerStyle}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout WidthRequest="110" Spacing="2">
                            <Label Style="{StaticResource EyebrowLabelStyle}" Text="RITUAL" />
                            <Picker ItemsSource="{Binding BooleanOptions}" SelectedItem="{Binding SelectedRitual}" Style="{StaticResource CompactPickerStyle}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout WidthRequest="150" Spacing="2">
                            <Label Style="{StaticResource EyebrowLabelStyle}" Text="CASTEO" />
                            <Picker ItemsSource="{Binding CastingTimeOptions}" SelectedItem="{Binding SelectedCastingTime}" Style="{StaticResource CompactPickerStyle}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout WidthRequest="150" Spacing="2">
                            <Label Style="{StaticResource EyebrowLabelStyle}" Text="COMPONENTE" />
                            <Picker ItemsSource="{Binding ComponentOptions}" SelectedItem="{Binding SelectedComponent}" Style="{StaticResource CompactPickerStyle}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout IsVisible="{Binding ShowExploitFilters}" Spacing="8">
                        <VerticalStackLayout WidthRequest="145" Spacing="2">
                            <Label Style="{StaticResource EyebrowLabelStyle}" Text="TIPO" />
                            <Button Clicked="OnExploitTypeFilterClicked" Style="{StaticResource SmallSecondaryButtonStyle}" Text="{Binding SelectedExploitType}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout WidthRequest="150" Spacing="2">
                            <Label Style="{StaticResource EyebrowLabelStyle}" Text="CLASE" />
                            <Button Clicked="OnExploitClassFilterClicked" IsEnabled="{Binding CanChooseExploitClass}" Style="{StaticResource SmallSecondaryButtonStyle}" Text="{Binding SelectedExploitClass}">
                                <Button.Triggers><DataTrigger Binding="{Binding CanChooseExploitClass}" TargetType="Button" Value="False"><Setter Property="Opacity" Value="0.5" /></DataTrigger></Button.Triggers>
                            </Button>
                        </VerticalStackLayout>
                        <VerticalStackLayout WidthRequest="125" Spacing="2">
                            <Label Style="{StaticResource EyebrowLabelStyle}" Text="NIVEL" />
                            <Button Clicked="OnExploitLevelFilterClicked" IsEnabled="{Binding CanUseExploitSubfilters}" Style="{StaticResource SmallSecondaryButtonStyle}" Text="{Binding SelectedExploitLevel}">
                                <Button.Triggers><DataTrigger Binding="{Binding CanUseExploitSubfilters}" TargetType="Button" Value="False"><Setter Property="Opacity" Value="0.5" /></DataTrigger></Button.Triggers>
                            </Button>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <VerticalStackLayout WidthRequest="180" Spacing="2">
                        <Label Style="{StaticResource EyebrowLabelStyle}" Text="ORDEN" />
                        <Picker ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" Style="{StaticResource CompactPickerStyle}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </ScrollView>
        </Grid>
        <Grid Grid.Row="2" Margin="16,4,16,6" RowDefinitions="Auto,Auto">
            <Label Style="{StaticResource SectionLabelStyle}" Text="{Binding ResultSummary}" />
            <Label Grid.Row="1" Margin="0,5,0,0" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabelStyle}" Text="{Binding ErrorMessage}" />
        </Grid>
        <RefreshView Grid.Row="3" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView Margin="10,0" ItemsSource="{Binding Items}" ItemsUpdatingScrollMode="KeepScrollOffset" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="28" Spacing="8">
                        <Label HorizontalTextAlignment="Center" Style="{StaticResource TitleLabelStyle}" Text="Todavía no hay preparados" />
                        <Label HorizontalTextAlignment="Center" Style="{StaticResource MutedLabelStyle}" Text="{Binding EmptyText}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:SavedItemViewModel">
                        <Border Margin="2,0,2,9" Padding="13" Style="{StaticResource CardStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <Button
                                    Grid.RowSpan="3"
                                    Margin="0,0,10,0"
                                    Padding="7,12"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    FontAttributes="Bold"
                                    FontSize="28"
                                    IsVisible="{Binding BindingContext.CanReorder, Source={x:Reference PreparedRoot}}"
                                    Loaded="OnPreparedHandleLoaded"
                                    SemanticProperties.Description="Mantener presionado y arrastrar para cambiar el orden"
                                    Text="⋮"
                                    TextColor="{StaticResource Gold}"
                                    Unloaded="OnPreparedHandleUnloaded"
                                    VerticalOptions="Center">
                                    <Button.GestureRecognizers>
                                        <PanGestureRecognizer PanUpdated="OnPreparedPanUpdated" />
                                    </Button.GestureRecognizers>
                                </Button>
                                <Label Grid.Column="1" FontAttributes="Bold" FontSize="16" Text="{Binding Name}" TextColor="{StaticResource TextPrimary}" />
                                <Label Grid.Column="2" FontAttributes="Bold" FontSize="10" Text="{Binding Kind}" TextColor="{StaticResource Gold}" />
                                <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="12" Text="{Binding LevelText}" />
                                <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="80,0,0,0" FontSize="12" Text="{Binding DetailText}" TextColor="{StaticResource TextMuted}" />
                                <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" HorizontalOptions="End" Spacing="6">
                                    <Button Command="{Binding BindingContext.RemoveCommand, Source={x:Reference PreparedRoot}}" CommandParameter="{Binding .}" Style="{StaticResource SmallSecondaryButtonStyle}" Text="Quitar" />
                                    <Button Command="{Binding BindingContext.OpenDetailCommand, Source={x:Reference PreparedRoot}}" CommandParameter="{Binding .}" Style="{StaticResource SmallAccentButtonStyle}" Text="Ver todo" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Grid x:Name="FilterOverlay" Grid.RowSpan="4" Padding="28" BackgroundColor="#B0000000" IsVisible="False" ZIndex="100">
            <Border MaximumHeightRequest="560" Padding="14" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Outline}" VerticalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Label x:Name="FilterMenuTitle" Style="{StaticResource TitleLabelStyle}" />
                    <CollectionView x:Name="FilterOptionsList" Grid.Row="1" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:SavedFilterOption">
                                <Button Margin="0,2" Clicked="OnFilterOptionClicked" CommandParameter="{Binding Value}" IsEnabled="{Binding IsAvailable}" Style="{StaticResource SmallGhostButtonStyle}" Text="{Binding Value}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button Grid.Row="2" Clicked="OnCloseFilterMenuClicked" Style="{StaticResource SmallSecondaryButtonStyle}" Text="Cerrar" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentView>
