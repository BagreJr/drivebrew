<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DndCompendium.App.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:DndCompendium.App.ViewModels"
    xmlns:views="clr-namespace:DndCompendium.App.Views"
    x:DataType="viewModels:DownloadsViewModel"
    >

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Border
            Grid.Row="0"
            Margin="16,14,16,8"
            Padding="20"
            Style="{StaticResource HeroCardStyle}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                <Label Style="{StaticResource EyebrowLabelStyle}" Text="ALMACENAMIENTO LOCAL" />
                <Label
                    Grid.Row="1"
                    Margin="0,4,12,0"
                    Style="{StaticResource DisplayLabelStyle}"
                    Text="Descargas" />
                <Label
                    Grid.Row="2"
                    Margin="0,8,12,0"
                    Style="{StaticResource MutedLabelStyle}"
                    Text="{Binding StorageUsageText}" />
                <ActivityIndicator
                    Grid.RowSpan="3"
                    Grid.Column="1"
                    HeightRequest="28"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    VerticalOptions="Center"
                    WidthRequest="28" />
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Margin="16,0,16,8"
            Padding="14"
            Style="{StaticResource CardStyle}">
            <VerticalStackLayout Spacing="12">
                <Label Style="{StaticResource SectionLabelStyle}" Text="CATÁLOGOS JSON" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="3">
                    <Label Style="{StaticResource TitleLabelStyle}" Text="Spells" />
                    <Label Grid.Row="1" Margin="0,0,8,0" Style="{StaticResource MutedLabelStyle}" Text="{Binding SpellsCatalogStatus}" />
                    <Button Grid.RowSpan="2" Grid.Column="1" Command="{Binding UpdateSpellsCommand}" IsEnabled="{Binding IsUpdatingSpells, Converter={StaticResource InvertedBoolConverter}}" Style="{StaticResource SmallAccentButtonStyle}" Text="Actualizar" />
                </Grid>
                <BoxView HeightRequest="1" Style="{StaticResource DividerStyle}" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="3">
                    <Label Style="{StaticResource TitleLabelStyle}" Text="Exploits" />
                    <Label Grid.Row="1" Margin="0,0,8,0" Style="{StaticResource MutedLabelStyle}" Text="{Binding ExploitsCatalogStatus}" />
                    <Button Grid.RowSpan="2" Grid.Column="1" Command="{Binding UpdateExploitsCommand}" IsEnabled="{Binding IsUpdatingExploits, Converter={StaticResource InvertedBoolConverter}}" Style="{StaticResource SmallAccentButtonStyle}" Text="Actualizar" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Border
            Grid.Row="2"
            Margin="16,0,16,8"
            Padding="12,9"
            BackgroundColor="{StaticResource ErrorSurface}"
            IsVisible="{Binding HasError}"
            Stroke="{StaticResource Error}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Label Style="{StaticResource ErrorLabelStyle}" Text="{Binding ErrorMessage}" />
        </Border>

        <RefreshView
            Grid.Row="3"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsRefreshing}">
            <CollectionView
                Margin="12,0"
                ItemsSource="{Binding Jobs}"
                SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="32,64" Spacing="10">
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource TitleLabelStyle}"
                            Text="No hay descargas activas" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource MutedLabelStyle}"
                            Text="Los documentos que descargues aparecerán acá con su progreso." />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DownloadJobItemViewModel">
                        <Border Margin="4,4,4,10" Padding="16" Style="{StaticResource CardStyle}">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="9">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Style="{StaticResource TitleLabelStyle}" Text="{Binding Title}" />
                                        <Label Style="{StaticResource EyebrowLabelStyle}" Text="{Binding StateText}" />
                                    </VerticalStackLayout>
                                    <Label
                                        Grid.Column="1"
                                        Style="{StaticResource MutedLabelStyle}"
                                        Text="{Binding UpdatedText}"
                                        VerticalOptions="Center" />
                                </Grid>

                                <ProgressBar Grid.Row="1" Progress="{Binding Progress}" />

                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                    <Label Style="{StaticResource MutedLabelStyle}" Text="{Binding ProgressText}" />
                                    <Label
                                        Grid.Column="1"
                                        IsVisible="{Binding HasError}"
                                        Style="{StaticResource ErrorLabelStyle}"
                                        Text="{Binding ErrorMessage}" />
                                </Grid>

                                <HorizontalStackLayout
                                    Grid.Row="3"
                                    HorizontalOptions="End"
                                    Spacing="8">
                                    <Button
                                        Command="{Binding BindingContext.PauseCommand, Source={RelativeSource AncestorType={x:Type views:DownloadsPage}}}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding CanPause}"
                                        Style="{StaticResource SmallSecondaryButtonStyle}"
                                        Text="Pausar" />
                                    <Button
                                        Command="{Binding BindingContext.ResumeCommand, Source={RelativeSource AncestorType={x:Type views:DownloadsPage}}}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding CanResume}"
                                        Style="{StaticResource SmallAccentButtonStyle}"
                                        Text="Reanudar" />
                                    <Button
                                        Command="{Binding BindingContext.RetryCommand, Source={RelativeSource AncestorType={x:Type views:DownloadsPage}}}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding CanRetry}"
                                        Style="{StaticResource SmallAccentButtonStyle}"
                                        Text="Reintentar" />
                                    <Button
                                        Command="{Binding BindingContext.CancelCommand, Source={RelativeSource AncestorType={x:Type views:DownloadsPage}}}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding CanCancel}"
                                        Style="{StaticResource SmallGhostButtonStyle}"
                                        Text="Cancelar" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentView>
