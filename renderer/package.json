{
  "name": "dnd-compendium-offline-renderer",
  "version": "1.0.0",
  "private": true,
  "description": "Reproducible browser assets for the offline D&D Compendium HybridWebView.",
  "type": "module",
  "scripts": {
    "build": "node ./build.mjs",
    "verify": "node ./verify.mjs",
    "visual:verify": "node ./visual-verify.mjs",
    "visual:update": "node ./visual-verify.mjs --update",
    "rebuild": "npm run build && npm run verify"
  },
  "dependencies": {
    "expr-eval": "2.0.2",
    "js-yaml": "5.4.3",
    "lodash": "4.18.1",
    "marked": "15.0.12",
    "marked-alignment-paragraphs": "1.0.0",
    "marked-definition-lists": "1.0.1",
    "marked-diagrams-markdeep": "1.0.1",
    "marked-emoji": "2.0.3",
    "marked-extended-tables": "2.0.1",
    "marked-gfm-heading-id": "4.1.4",
    "marked-hbfm": "1.0.1",
    "marked-nonbreaking-spaces": "1.0.1",
    "marked-smartypants-lite": "1.0.3",
    "marked-subsuper-text": "1.0.4",
    "marked-variables": "1.0.7",
    "romans": "3.1.0",
    "written-number": "0.11.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "less": "4.9.1",
    "pixelmatch": "7.1.0",
    "playwright-core": "1.56.1",
    "pngjs": "7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
